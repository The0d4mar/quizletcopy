generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DeckShareRole {
  VIEWER
  EDITOR
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  sessions      Session[]
  decks         Deck[]
  folders       Folder[]
  cardProgress  CardProgress[]
  deckShares    DeckShare[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Deck {
  id          String   @id @default(cuid())
  title       String
  description String?
  isPublic    Boolean  @default(false)
  lastRepeat  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  cards   Card[]
  folders Folder[]    @relation("FolderDecks")
  shares  DeckShare[]

  @@index([ownerId])
  @@index([isPublic])
}

model DeckShare {
  id        String        @id @default(cuid())
  role      DeckShareRole @default(VIEWER)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([deckId, userId])
  @@index([userId])
  @@index([deckId])
}

model Card {
  id          String   @id @default(cuid())
  original    String
  translation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  progress CardProgress[]

  @@index([deckId])
}

model Folder {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  decks Deck[] @relation("FolderDecks")

  @@index([ownerId])
}

model CardProgress {
  id           String    @id @default(cuid())
  numOfRepeats Int       @default(0)
  wrongRepeats Int       @default(0)
  lastRepeat   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}